datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String           @id // U-XXXXXX
  email              String           @unique
  password           String
  hashAlgorithm      String           @default("SHA256") // SHA256, BCRYPT, ARGON2ID
  name               String?
  role               String           @default("User") // SuperAdmin, Vendor, User
  agencyRole         String?          @default("OWNER") // OWNER, MANAGER, ACCOUNTANT, GUIDE
  phoneNumber        String?
  status             String           @default("Active") // Active, Suspended, Invited
  lastLoginAt        DateTime?
  loyaltyPoints      Int              @default(0)
  companyId          String?          // For Vendor users
  company            Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  twoFactorSecret    String?
  twoFactorEnabled   Boolean          @default(false)
  deletedAt          DateTime?
  deletedBy          String?
  deleteReason       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  usages             CampaignUsage[]
  loyaltyLogs        LoyaltyHistory[]
  sessions           Session[]
  refreshSessions    RefreshSession[]
  waitingLists       WaitingList[]
  reviews            Review[]
  guidedTours        Tour[]           @relation("TourGuide")
  favorites          UserFavorite[]
  hotelBookings      HotelBooking[]
  conversations      Conversation[]
  supportTickets     SupportTicket[]
  customRequests     CustomTourRequest[]
  customBookings     CustomTourBooking[]

  @@index([email])
  @@index([role])
  @@index([companyId])
}

model RefreshSession {
  id            String    @id // RS-XXXXXX
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @db.Text
  familyId      String
  parentTokenId String?
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Company {
  id               String                @id // C-XXXXXX
  name             String
  phoneNumber      String?
  email            String?
  address          String?
  voen             String?
  iban             String?
  bankName         String?
  status           String                @default("Pending") // Pending, Active, Suspended
  rating           Float                 @default(0.0)
  availableBalance Decimal               @default(0.0000) @db.Decimal(19, 4)
  pendingBalance   Decimal               @default(0.0000) @db.Decimal(19, 4)
  payoutAccount         String?
  legalName             String?
  logoUrl               String?
  coverUrl              String?
  description           String?               @db.Text
  website               String?
  city                  String?
  workingHours          String?
  socialLinks           String?               @db.Text
  bankVoen              String?
  bankCode              String?
  swiftBic              String?
  accountantName        String?
  accountantPhone       String?
  notificationSettings  String?               @db.Text
  planId                String?
  plan                  SubscriptionPlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  autoRenewSubscription Boolean               @default(true)
  nextBillingDate       DateTime?
  deletedAt             DateTime?
  deletedBy        String?
  deleteReason     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  users            User[]
  tours            Tour[]
  bookings         Booking[]
  transactions     Transaction[]
  payouts          Payout[]
  campaigns        Campaign[]
  ads              Ad[]
  payments         SubscriptionPayment[]
  ledgerAccounts   LedgerAccount[]
  apiKeys          ApiKey[]
  webhooks         Webhook[]
  hotels           Hotel[]
  hotelBookings    HotelBooking[]
  conversations    Conversation[]
  supportTickets   SupportTicket[]
  cannedResponses  CannedResponse[]
  customBids       CustomTourBid[]
  customBookings   CustomTourBooking[]

  @@index([status])
  @@index([planId])
}

model SubscriptionPlan {
  id                 String                @id // SP-XXXXXX
  name               String
  monthlyPrice       Decimal               @db.Decimal(19, 4)
  domesticCommission Decimal               @db.Decimal(19, 4)
  foreignCommission  Decimal               @db.Decimal(19, 4)
  features           String                @db.Text // JSON string of features
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  companies          Company[]
  payments           SubscriptionPayment[]
}

model SubscriptionPayment {
  id          String           @id // SPY-XXXXXX
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId      String
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  amount      Decimal          @db.Decimal(19, 4)
  paymentDate DateTime         @default(now())
  dueDate     DateTime
  status      String           @default("Pending") // Paid, Overdue, Pending

  @@index([companyId])
  @@index([planId])
  @@index([status])
}

model Tour {
  id                    String       @id // T-XXXXXX
  companyId             String
  company               Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type                  String       // DOMESTIC, FOREIGN
  title                 String
  description           String       @db.Text
  phoneNumber           String?
  email                 String?
  images                String?      @db.Text // JSON string of image paths
  minParticipants       Int          @default(1)
  maxParticipants       Int
  startDate             DateTime
  endDate               DateTime?
  includedServices      String?      @db.Text // JSON list
  excludedServices      String?      @db.Text // JSON list
  itinerary             String?      @db.Text // JSON list
  status                String       @default("Active") // Active, Deactive
  viewCount             Int          @default(0)
  favoriteCount         Int          @default(0)
  
  // Domestic specific
  transportType         String?      // Bus, Mercedes Sprinter, etc.
  busCapacity           Int?
  meetingPointAddress   String?
  meetingPointLat       Float?
  meetingPointLng       Float?
  guideId               String?
  guide                 User?        @relation("TourGuide", fields: [guideId], references: [id], onDelete: SetNull)
  driverName            String?
  driverPhone           String?
  busPlateNumber        String?
  departureNotes        String?      @db.Text
  
  // Common / Foreign specific
  destinationCountry    String?
  hotelName             String?
  hotelCategory         String?      // 3*, 4*, 5*
  currency              String       @default("AZN")
  price                 Decimal      @db.Decimal(19, 4)
  flightIncluded        Boolean      @default(false)
  passportVisaRequired  Boolean      @default(false)

  // FinTech & Depozit Qaydaları
  allowInstallments     Boolean      @default(true)
  maxInstallmentMonths  Int          @default(12)
  allowDeposit          Boolean      @default(true)
  depositPercentage     Decimal      @default(30.0000) @db.Decimal(5, 2)
  depositDueDaysBefore  Int          @default(5)

  // Smart Yield & Dinamik Qiymət (Faza 6)
  dynamicPricingActive  Boolean      @default(false)
  surgeThreshold        Int          @default(5)
  surgePercent          Int          @default(10)
  lastMinuteHours       Int          @default(36)
  lastMinuteDiscount    Int          @default(15)
  lastMinuteMinOccupancy Int         @default(60)
  earlyBirdDays         Int          @default(21)
  earlyBirdDiscount     Int          @default(10)

  deletedAt             DateTime?
  deletedBy             String?
  deleteReason          String?

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  regions               TourRegion[]
  bookings              Booking[]
  ads                   Ad[]
  waitingList           WaitingList[]
  reviews               Review[]
  favorites             UserFavorite[]
  recommendedHotels     TourHotelRecommendation[]

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@index([startDate])
  @@index([guideId])
}

model TourRegion {
  id     Int    @id @default(autoincrement())
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  name   String // Rayon adı (Quba, Qusar, Şəki və s.)

  @@index([tourId])
}

model Booking {
  id               String        @id // TR-XXXXXX
  tourId           String
  tour             Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  passengerName    String
  passengerSurname String
  passengerPassport String?      // Passport details/number
  contactNumber    String
  contactEmail     String
  bookingDate      DateTime      @default(now())
  seats            Int           @default(1)
  busSeatNumber    String?       // For domestic bus seat assignment
  status           String        @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  paymentStatus    String        @default("PENDING") // PAID, PARTIALLY_PAID, PENDING, OVERDUE, REFUNDED
  paymentType      String        @default("FULL")    // FULL, DEPOSIT
  paidAmount       Decimal       @default(0.0000) @db.Decimal(19, 4)
  remainingAmount  Decimal       @db.Decimal(19, 4)
  totalAmount      Decimal       @db.Decimal(19, 4)
  depositDueDate   DateTime?     // Qalıq 70%-in son ödəniş tarixi
  depositPaidAt    DateTime?     // 30% depozitin ödənildiyi tarix
  balancePaidAt    DateTime?     // Qalıq 70%-in ödənildiyi tarix
  balanceToken     String?       @unique // Link vasitəsilə birbaşa qalıq ödənişi üçün unikal token
  installmentMonths Int          @default(1) // 1 = Birdəfəlik, 2, 3, 6, 12, 18
  installmentCardType String?    // BIRKART, TAMKART, BOLKART, ALBALI, STANDARD
  depositRemindersSent Int       @default(0)
  documents        String?       @db.Text // JSON list of secure document file paths
  bookingChannel   String        @default("PLATFORM") // PLATFORM, MANUAL
  isCheckedIn      Boolean       @default(false)
  checkedInAt      DateTime?
  checkedInBy      String?
  qrToken          String?       @unique
  passengersData   String?       @db.Text // JSON array of passenger objects [{ seatNumber, fullName, phone, finCode, isCheckedIn }]
  deletedAt        DateTime?
  deletedBy        String?
  deleteReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[]
  notificationLogs NotificationDeliveryLog[]

  @@index([tourId])
  @@index([companyId])
  @@index([contactEmail])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentType])
  @@index([isCheckedIn])
}

model Transaction {
  id          String   @id // TX-XXXXXX
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  type        String   // TICKET_SALE, REFUND, PAYOUT, SUBSCRIPTION
  amount      Decimal  @db.Decimal(19, 4)
  commission  Decimal  @default(0.0000) @db.Decimal(19, 4)
  netAmount   Decimal  @db.Decimal(19, 4)
  status      String   @default("Pending") // Completed, Pending, Cancelled
  description String?
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([bookingId])
  @@index([type])
}

model Payout {
  id          String   @id // P-XXXXXX
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(19, 4)
  payoutDate  DateTime @default(now())
  status      String   @default("Pending") // Completed, Pending, Failed
  bankAccount String

  @@index([companyId])
  @@index([status])
}

model Campaign {
  id                 String          @id // CP-XXXXXX
  companyId          String?         // Null if Global Campaign by SuperAdmin
  company            Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type               String          // DISCOUNT, GIFT, LOYALTY
  promoCode          String          @unique
  discountType       String          // PERCENTAGE, FIXED
  discountValue      Decimal         @db.Decimal(19, 4)
  usageLimit         Int             @default(0) // 0 means unlimited
  usedCount          Int             @default(0)
  startDate          DateTime
  endDate            DateTime
  description        String?         @db.Text
  status             String          @default("Active") // Active, Expired
  createdAt          DateTime        @default(now())
  usages             CampaignUsage[]

  @@index([companyId])
}

model CampaignUsage {
  id         String   @id // CPU-XXXXXX
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt     DateTime @default(now())

  @@index([campaignId])
  @@index([userId])
}

model AdPackage {
  id           String  @id // ADP-XXXXXX
  name         String?
  durationDays Int
  price        Decimal @db.Decimal(19, 4)
  features     String  @db.Text // JSON string list
  ads          Ad[]
}

model Ad {
  id           String     @id // AD-XXXXXX
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tourId       String?
  tour         Tour?      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  packageId    String?
  package      AdPackage? @relation(fields: [packageId], references: [id])
  title        String?
  imageUrl     String?    @db.Text
  linkUrl      String?
  position     String     @default("HERO") // HERO, SIDEBAR, POPUP, VIP_LIST
  amountPaid   Decimal    @db.Decimal(19, 4) @default(0.0)
  startDate    DateTime
  endDate      DateTime
  status       String     @default("Active") // Active, Paused, Expired, Cancelled
  viewCount    Int        @default(0)
  clicksCount  Int        @default(0)
  bookingCount Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([companyId])
  @@index([tourId])
  @@index([status])
}

model LoyaltyOffer {
  id             String    @id // LYO-XXXXXX
  partnerName    String
  offerName      String
  description    String    @db.Text
  requiredPoints Int
  maxUsage       Int       @default(0)
  usedCount      Int       @default(0)
  category       String    // FOOD, SERVICE, TRAVEL, TRANSPORT
  startDate      DateTime?
  endDate        DateTime?
}

model LoyaltyHistory {
  id          String   @id // LYH-XXXXXX
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType  String   // EARNED, SPENT
  points      Int
  description String
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id // S-XXXXXX
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @db.Text
  device    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model WaitingList {
  id        String   @id // W-XXXXXX
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tourId])
  @@index([userId])
}

model Review {
  id        String   @id // R-XXXXXX
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5
  comment   String   @db.Text
  createdAt DateTime @default(now())

  @@index([tourId])
  @@index([userId])
}

model FAQ {
  id        String   @id // FAQ-XXXXXX
  question  String
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id        String   @id // B-XXXXXX
  title     String
  content   String   @db.Text
  author    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaticPage {
  id        String   @id // SPG-XXXXXX
  slug      String   @unique // terms, privacy, vb.
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

model LedgerAccount {
  id          String        @id // LA-XXXXXX
  tenantId    String?       // Multi-tenancy isolation
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        String        // ASSET, LIABILITY, REVENUE, EXPENSE
  name        String
  currency    String        @default("AZN")
  createdAt   DateTime      @default(now())
  entries     LedgerEntry[]

  @@index([tenantId])
  @@index([companyId])
}

model LedgerEntry {
  id            String        @id // LE-XXXXXX
  tenantId      String?
  journalId     String        // Group entries of a single financial transaction
  accountId     String
  account       LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bookingId     String?
  payoutId      String?
  entryType     String        // DEBIT, CREDIT
  debit         Decimal       @default(0.0000) @db.Decimal(19, 4)
  credit        Decimal       @default(0.0000) @db.Decimal(19, 4)
  currency      String        @default("AZN")
  exchangeRate  Decimal       @default(1.0000) @db.Decimal(19, 4)
  referenceType String?       // BOOKING_SALE, PAYOUT_EXECUTION, PLATFORM_COMMISSION, REFUND
  referenceId   String?
  description   String?
  createdAt     DateTime      @default(now())

  @@index([journalId])
  @@index([bookingId])
  @@index([tenantId])
  @@index([accountId])
}

model AuditLog {
  id          String   @id // AUD-XXXXXX
  tenantId    String?
  entityName  String
  entityId    String
  action      String   // CREATE, UPDATE, DELETE, CANCEL
  performedBy String?
  oldValues   String?  @db.Text
  newValues   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([entityName, entityId])
}

model WebhookLog {
  id             String   @id // WHL-XXXXXX
  provider       String   // Stripe, BirBank, Kapital, EManat, MilliON
  idempotencyKey String   @unique
  payload        String   @db.Text
  status         String   // PROCESSED, FAILED, SKIPPED_DUPLICATE
  createdAt      DateTime @default(now())

  @@index([provider])
}

model ApiKey {
  id                 String    @id // AK-XXXXXX
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  keyPrefix          String    // e.g. ts_live_4f92 or ts_test_8b11
  keyHash            String    @unique // SHA-256 hash of secret key
  environment        String    @default("LIVE") // LIVE, TEST
  scopes             String    @db.Text // JSON array: ["tours:read", "bookings:read", "bookings:write"]
  ipWhitelist        String?   @db.Text
  rateLimitPerMinute Int       @default(120)
  requestCount       Int       @default(0)
  status             String    @default("Active") // Active, Revoked
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([companyId])
  @@index([keyHash])
  @@index([status])
}

model Webhook {
  id                 String    @id // WH-XXXXXX
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  url                String
  secretKey          String    // e.g. whsec_...
  events             String    @db.Text // JSON array: ["booking.created", "booking.confirmed"]
  status             String    @default("Active") // Active, Disabled
  lastDeliveryAt     DateTime?
  lastDeliveryStatus String?   // 200 OK, 500 ERROR
  createdAt          DateTime  @default(now())

  @@index([companyId])
}

model NotificationDeliveryLog {
  id           String    @id // NDL-XXXXXX
  bookingId    String?
  booking      Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  channel      String    // WHATSAPP, SMS, EMAIL
  recipient    String    // Telefon nömrəsi və ya e-poçt
  templateName String    // booking_confirm, reminder_24h, reminder_2h, feedback_request
  status       String    // SENT, DELIVERED, FAILED
  payload      String?   @db.Text
  errorDetails String?   @db.Text
  sentAt       DateTime  @default(now())

  @@index([bookingId])
  @@index([channel])
  @@index([status])
}

model UserFavorite {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tourId])
  @@map("user_favorites")
}

// ----------------------------------------------------
// FAZA 3: OTEL VƏ QONAQLAMA EKOSİSTEMİ MODELLƏRİ
// ----------------------------------------------------

model Hotel {
  id                   String                    @id // H-XXXXXX
  companyId            String                    // C-XXXXXX (Vendor Company)
  company              Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                 String
  legalName            String?
  category             String                    @default("HOTEL_4_STAR") // HOTEL_1_STAR..HOTEL_5_STAR, BOUTIQUE, RESORT, COTTAGE_VILLA, HOSTEL
  starRating           Int                       @default(4)              // 1-5
  city                 String                    // Bakı, Şuşa, Quba, Qəbələ, Şəki, Lənkəran, Naxçıvan
  region               String                    // Qarabağ, Şimal, Qərb, Cənub, Abşeron
  address              String
  lat                  Float?
  lng                  Float?
  checkInTime          String                    @default("14:00")
  checkOutTime         String                    @default("12:00")
  description          String                    @db.Text
  amenities            String                    @db.Text                 // JSON string: ["WIFI", "POOL", "SPA", "PARKING", "RESTAURANT", "GYM", "KIDS_CLUB"]
  cancellationPolicy   String?                   @db.Text                 // Ləğv qaydaları
  images               String                    @db.Text                 // JSON string: ["url1", "url2"]
  featuredImage        String?
  rating               Float                     @default(0.0)
  reviewCount          Int                       @default(0)
  isFeatured           Boolean                   @default(false)
  isActive             Boolean                   @default(true)
  allowInstallments    Boolean                   @default(true)           // Birkart/Tamkart dəstəyi
  allowDeposit         Boolean                   @default(true)           // 30/70 depozit dəstəyi
  dynamicPricingActive Boolean                   @default(true)           // Avtomatik tələbat qiymət tənzimləməsi
  deletedAt            DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  roomTypes            RoomType[]
  hotelBookings        HotelBooking[]
  recommendedInTours   TourHotelRecommendation[]

  @@index([companyId])
  @@index([city])
  @@index([region])
  @@index([category])
  @@index([starRating])
  @@index([isActive])
}

model RoomType {
  id                   String                    @id // RT-XXXXXX
  hotelId              String
  hotel                Hotel                     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                 String                    // Standart İki Nəfərlik, Delüks Dağ Mənzərəli, Family Suite
  description          String?                   @db.Text
  capacityAdults       Int                       @default(2)
  capacityChildren     Int                       @default(1)
  maxOccupancy         Int                       @default(3)
  bedType              String                    @default("DOUBLE")       // SINGLE, DOUBLE, TWIN, QUEEN, KING, SOFA_BED
  bedCount             Int                       @default(1)
  roomSizeSqM          Int?                      // Otaq sahəsi (m²)
  mealPlan             String                    @default("BB")           // RO, BB, HB, FB, ALL_INCLUSIVE
  basePrice            Decimal                   @db.Decimal(10, 2)       // AZN / gecə
  totalRoomsCount      Int                       @default(5)              // Bu növdən oteldə olan cəmi otaq sayı
  amenities            String?                   @db.Text                 // JSON: ["BALCONY", "AIR_CONDITIONING", "MINIBAR", "SAFE", "TV"]
  images               String?                   @db.Text                 // JSON massiv
  isActive             Boolean                   @default(true)
  deletedAt            DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  availabilityCalendar RoomAvailabilityCalendar[]
  hotelBookings        HotelBooking[]

  @@index([hotelId])
  @@index([basePrice])
  @@index([capacityAdults])
  @@index([isActive])
}

model RoomAvailabilityCalendar {
  id                 String    @id // RAC-XXXXXX
  roomTypeId         String
  roomType           RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date               DateTime  @db.Date
  availableCount     Int       // Həmin gün üçün qalan boş otaq sayı
  priceOverride      Decimal?  @db.Decimal(10, 2) // Xüsusi gün / bayram qiyməti
  isBlocked          Boolean   @default(false)    // Otaq bağlıdır / təmir
  demandSurgeApplied Boolean   @default(false)    // Avtomatik surge tətbiq edilibmi
  surgeMultiplier    Float     @default(1.0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([roomTypeId, date])
  @@index([date])
  @@index([roomTypeId])
}

model HotelBooking {
  id                  String    @id // HB-XXXXXX
  bookingNumber       String    @unique // HTR-XXXXXX
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hotelId             String
  hotel               Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId          String
  roomType            RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  checkInDate         DateTime  @db.Date
  checkOutDate        DateTime  @db.Date
  nightsCount         Int       @default(1)
  roomsCount          Int       @default(1)
  guestsCount         Int       @default(2)
  primaryGuestName    String
  primaryGuestPhone   String
  primaryGuestEmail   String?
  guestNotes          String?   @db.Text
  totalAmount         Decimal   @db.Decimal(10, 2)
  paidAmount          Decimal   @default(0.00) @db.Decimal(10, 2)
  paymentType         String    @default("FULL")    // FULL, DEPOSIT, INSTALLMENT
  paymentMethod       String?                       // BIRBANK, TAMKART, BOLKART, ALBALI, KAPITAL_BANK, STRIPE
  paymentStatus       String    @default("PENDING") // PENDING, PAID, PARTIALLY_PAID, CANCELLED
  status              String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  balanceToken        String?   @unique             // Qalıq ödəniş linki üçün
  depositDueDate      DateTime?
  installmentMonths   Int?
  cancellationReason  String?
  qrCodeToken         String?   @unique
  linkedTourBookingId String?                       // Çarpaz tur paketi olduqda
  crossSellDiscount   Decimal?  @db.Decimal(10, 2)  // Paket endirimi
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([hotelId])
  @@index([roomTypeId])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@index([status])
  @@index([paymentStatus])
}

model TourHotelRecommendation {
  id                     String   @id // THR-XXXXXX
  tourId                 String
  tour                   Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  hotelId                String
  hotel                  Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  packageDiscountPercent Int      @default(10) // Tur ilə birlikdə bron edildikdə 10% endirim
  createdAt              DateTime @default(now())

  @@unique([tourId, hotelId])
  @@index([tourId])
  @@index([hotelId])
}

// ==========================================
// FAZA 4: REAL-TIME CHAT & TICKETS
// ==========================================

model Conversation {
  id                String        @id // C-XXXXXX
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  contextType       String        @default("GENERAL") // GENERAL, TOUR, HOTEL, BOOKING
  contextTourId     String?
  contextHotelId    String?
  contextBookingId  String?
  
  pinnedMeta        String?       @db.Text // JSON string: { title, price, date, image, code }
  
  status            String        @default("ACTIVE") // ACTIVE, ARCHIVED, BLOCKED
  lastMessageText   String?       @db.Text
  lastMessageAt     DateTime      @default(now())
  
  unreadCountUser   Int           @default(0)
  unreadCountVendor Int           @default(0)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  messages          ChatMessage[]

  @@index([userId])
  @@index([companyId])
  @@index([lastMessageAt])
}

model ChatMessage {
  id             String       @id // CM-XXXXXX
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId       String       // User ID
  senderRole     String       @default("USER") // USER, VENDOR, ADMIN, SYSTEM
  
  content        String       @db.Text
  attachments    String?      @db.Text // JSON string: [{ name, url, type, size }]
  
  isRead         Boolean      @default(false)
  readAt         DateTime?
  isSystemEvent  Boolean      @default(false)
  
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model SupportTicket {
  id               String          @id // TCK-XXXXXX
  ticketNumber     String          @unique // TCK-849201
  
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        String?
  company          Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  
  bookingId        String?
  
  category         String          @default("GENERAL_SUPPORT") // REFUND_REQUEST, DATE_OR_SEAT_CHANGE, COMPLAINT, PAYMENT_ISSUE, GENERAL_SUPPORT
  priority         String          @default("MEDIUM")          // LOW, MEDIUM, HIGH, URGENT
  status           String          @default("OPEN")            // OPEN, IN_PROGRESS, WAITING_CUSTOMER, RESOLVED, CLOSED, ESCALATED_TO_ADMIN
  
  subject          String
  description      String          @db.Text
  attachments      String?         @db.Text // JSON string
  
  requestedRefund  Decimal?        @db.Decimal(10, 2)
  approvedRefund   Decimal?        @db.Decimal(10, 2)
  
  assignedAdminId  String?
  internalNotes    String?         @db.Text
  
  resolutionReason String?         @db.Text
  resolvedAt       DateTime?
  closedAt         DateTime?
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  messages         TicketMessage[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([category])
}

model TicketMessage {
  id             String        @id // TM-XXXXXX
  ticketId       String
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  senderId       String
  senderRole     String        @default("USER") // USER, VENDOR, ADMIN
  
  message        String        @db.Text
  attachments    String?       @db.Text // JSON string
  isInternalNote Boolean       @default(false)
  
  createdAt      DateTime      @default(now())

  @@index([ticketId])
}

model CannedResponse {
  id          String   @id // CR-XXXXXX
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  shortcut    String
  content     String   @db.Text
  category    String?  @default("GENERAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

// ----------------------------------------------------
// FAZA 5: FƏRDİ & KORPORATİV TURLAR VƏ B2B TENDER SİSTEMİ
// ----------------------------------------------------

model CustomTourRequest {
  id               String            @id // CTR-XXXXXX
  requestNumber    String            @unique // CTR-104928
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type             String            @default("FAMILY") // INDIVIDUAL, FAMILY, FRIENDS_GROUP, CORPORATE, SCHOOL_STUDENT
  title            String            // məs. "Qəbələ-Şəki Ailəvi İstirahət"
  destinations     String            @db.Text // JSON array: ["Qəbələ", "Şəki"]
  
  startDate        DateTime
  endDate          DateTime
  durationDays     Int               @default(1)
  
  adultsCount      Int               @default(2)
  childrenCount    Int               @default(0)
  totalPassengers  Int               @default(2)
  
  vehicleType      String            @default("MINIVAN_MERCEDES_VITO_7") // SEDAN_4, MINIVAN_MERCEDES_VITO_7, MINIBUS_MERCEDES_SPRINTER_18, BUS_NEOPLAN_50, OWN_TRANSPORT
  hotelPreference  String            @default("HOTEL_4_STAR") // NONE, HOTEL_3_STAR, HOTEL_4_STAR, HOTEL_5_STAR, COTTAGES, BOUTIQUE
  mealPreference   String            @default("BREAKFAST_ONLY") // NONE, BREAKFAST_ONLY, HALF_BOARD, FULL_BOARD, CORPORATE_BANQUET
  
  guideRequired    Boolean           @default(false)
  guideLanguage    String?           @default("AZ") // AZ, EN, RU, AR
  
  attractions      String?           @db.Text // JSON array: ["Tufandağ Kanat", "Şəki Xan Sarayı"]
  budgetMin        Decimal?          @db.Decimal(10, 2)
  budgetMax        Decimal?          @db.Decimal(10, 2)
  currency         String            @default("AZN")
  
  specialNotes     String?           @db.Text
  
  status           String            @default("OPEN_FOR_BIDS") // OPEN_FOR_BIDS, BIDS_REVIEW, ACCEPTED, PAID_CONFIRMED, COMPLETED, CANCELLED, EXPIRED
  acceptedBidId    String?
  bidsCount        Int               @default(0)
  
  expiresAt        DateTime          // Tender bitmə anı (məs. 48 saat)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  bids             CustomTourBid[]
  booking          CustomTourBooking?

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model CustomTourBid {
  id                String            @id // BID-XXXXXX
  bidNumber         String            @unique // BID-938210
  requestId         String
  request           CustomTourRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  offeredPrice      Decimal           @db.Decimal(10, 2) // Ümumi qiymət
  pricePerPerson    Decimal           @db.Decimal(10, 2)
  
  itineraryProgram  String            @db.Text // Günbəgün ətraflı səyahət proqramı (JSON və ya Markdown)
  includedServices  String            @db.Text // JSON array: ["Mercedes Vito VIP transfer", "4* Marxal Resort", "Bələdçi", "Kanat bileti"]
  excludedServices  String?           @db.Text // JSON array: ["Spirtli içkilər", "Nahar yeməyi"]
  
  vehicleDetails    String?           // məs. "2023 Mercedes Vito VIP, dəri salon, Wi-Fi, soyuducu"
  hotelDetails      String?           // məs. "Marxal Resort & Spa 4*, 2 ədəd Deluxe otaq"
  
  status            String            @default("PENDING") // PENDING, SHORTLISTED, ACCEPTED, REJECTED, EXPIRED
  validUntil        DateTime
  vendorNotes       String?           @db.Text
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  bookings          CustomTourBooking[]

  @@index([requestId])
  @@index([companyId])
  @@index([status])
}

model CustomTourBooking {
  id                String            @id // CTB-XXXXXX
  bookingNumber     String            @unique // CTB-582910
  requestId         String            @unique
  request           CustomTourRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  bidId             String
  bid               CustomTourBid     @relation(fields: [bidId], references: [id], onDelete: Cascade)
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id])
  
  totalAmount       Decimal           @db.Decimal(10, 2)
  paidAmount        Decimal           @db.Decimal(10, 2)
  balanceAmount     Decimal           @db.Decimal(10, 2) @default(0)
  
  paymentType       String            @default("FULL") // FULL, DEPOSIT_30, INSTALLMENT
  paymentStatus     String            @default("PAID") // PAID, PARTIALLY_PAID
  
  voucherCode       String            @unique // QR voucher kod
  status            String            @default("CONFIRMED") // CONFIRMED, COMPLETED, CANCELLED
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([companyId])
}

model DynamicPriceLog {
  id             String    @id @default(uuid())
  tourId         String?
  hotelId        String?
  basePrice      Decimal   @db.Decimal(19, 4)
  appliedPrice   Decimal   @db.Decimal(19, 4)
  ruleTriggered  String    // SURGE_HIGH_DEMAND, LAST_MINUTE_FLASH, EARLY_BIRD_DISCOUNT, STANDARD
  occupancyRate  Float?
  createdAt      DateTime  @default(now())

  @@index([tourId])
  @@index([hotelId])
  @@index([ruleTriggered])
}

model AiSearchLog {
  id               String    @id @default(uuid())
  userId           String?
  prompt           String    @db.Text
  parsedCriteria   String?   @db.Text // JSON string
  recommendedIds   String?   @db.Text // JSON string
  createdAt        DateTime  @default(now())

  @@index([userId])
}



